{
  "name": "p4-piweb-plugins",
  "private": true,
  "type": "module",
  "description": "Plugins we build for PI WEB, kept in one package so they are found, explained and installed together.",
  "piWeb": {
    "plugins": [
      {
        "id": "p4.catalog",
        "browserRoot": ".",
        "module": "catalog/pi-web-plugin.js"
      },
      {
        "id": "p4.cycles",
        "browserRoot": ".",
        "module": "cycles/pi-web-plugin.js",
        "serverModule": "cycles/server-plugin.js",
        "machineSpecific": true
      },
      {
        "id": "p4.models",
        "browserRoot": ".",
        "module": "models/pi-web-plugin.js",
        "serverModule": "models/server-plugin.js",
        "machineSpecific": true
      }
    ]
  },
  "pi": {
    "extensions": [
      "./activity/activity.js"
    ]
  }
}