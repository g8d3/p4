{
  "manifest_version": 3,
  "name": "BookmarkVault (local-first X-bookmark backup)",
  "short_name": "BookmarkVault",
  "version": "0.3.10",
  "description": "Back up your X bookmarks and likes locally while you browse. Full-history import scrolls slowly only after you tap Start.",
  "minimum_chrome_version": "114",
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "http://127.0.0.1/*", "http://localhost/*", "https://*/*", "http://*.ts.net/*"],
  "permissions": ["storage", "alarms", "sidePanel", "scripting"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["loader.js", "panel.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": { "default_path": "sidepanel/index.html" },
  "action": { "default_title": "BookmarkVault" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
