#!/bin/bash
# pi-web-restart-resume — one-line daemon restart that brings the session back.
# No timers, no arbitrary waits: it drops a resume request in the queue and
# restarts the daemon. systemd itself runs pi-web-resume.service right after
# (PartOf + After), which delivers the prompt the instant the daemon answers.
# Sessions persist on disk; the prompt is the only thing that restarts work.
# Usage: pi-web-restart-resume <session-id> [cwd] [message...]
#   cwd defaults to /home/vuos/code/p4; message defaults to a generic
#   continue-where-you-stopped prompt (no handoff file needed for routine use).
set -u
SID="${1:?usage: pi-web-restart-resume <session-id> [cwd] [message]}"
CWD="${2:-/home/vuos/code/p4}"
if [ "$#" -gt 2 ]; then shift 2; MSG="$*"; else MSG=""; fi
if [ -z "$MSG" ]; then
  MSG="The session daemon restarted as planned. Your transcript, workspace files and settings are intact. Continue the work you were doing before the restart from where it stopped, then report briefly what you did and current status."
fi
QUEUE="$HOME/.pi-web/resume-queue"
mkdir -p "$QUEUE"
python3 - "$QUEUE/$SID.json" "$SID" "$CWD" "$MSG" <<'PYEOF'
import json, sys
_, path, sid, cwd, msg = sys.argv
json.dump({'sid': sid, 'cwd': cwd, 'message': msg},
          open(path, 'w', encoding='utf-8'), indent=1)
PYEOF
python3 - "$QUEUE/$SID.json" "$SID" <<'PYEOF'
import json, sys
_, path, sid = sys.argv
d = json.load(open(path, encoding='utf-8'))
assert d.get('sid') == sid and d.get('cwd') and d.get('message'), 'queue write failed'
PYEOF
systemctl --user restart pi-web-sessiond && \
echo "restart issued; resume of $SID fires automatically when the daemon is back"
