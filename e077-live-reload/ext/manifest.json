{
  "manifest_version": 3,
  "name": "Live Reload Loader",
  "version": "1.7",
  "description": "Install once. Takes a server address, receives its URL list, hot-injects them. No reinstall loop.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
