{
  "manifest_version": 3,
  "name": "EchoLike Lite",
  "version": "1.12.0",
  "description": "Saves your X likes and bookmarks, sends them to your inbox.",
  "key": "",
  "update_url": "https://echolike.app/extension_update_lite.json",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "EchoLike Lite \u2014 inbox and settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "app.html#settings",
    "open_in_tab": true
  }
}
